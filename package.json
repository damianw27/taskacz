{
  "name": "taskacz",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev:desktop": "vite -c vite.desktop.config.ts",
    "dev:mobile": "vite -c vite.mobile.config.ts",
    "build:desktop": "tsc && vite build -c vite.desktop.config.ts",
    "build:mobile": "tsc && vite build -c vite.mobile.config.ts",
    "start": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 neu run",
    "start:local": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 ./bin/neutralino-linux_x64 --load-dir-res --path=.",
    "compile": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 neu build",
    "compile:prod": "cross-env WEBKIT_DISABLE_DMABUF_RENDERER=1 neu build --release",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "mobile:android": "bun build:mobile && cap sync android",
    "mobile:ios": "bun build:mobile && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/preferences": "^8.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/noto-sans-devanagari": "^5.2.8",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-sans-tc": "^5.2.9",
    "@neutralinojs/lib": "^6.5.0",
    "i18next": "^25.8.4",
    "install": "^0.13.0",
    "npm": "^11.10.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@capacitor/cli": "^8.0.2",
    "@neutralinojs/neu": "^11.7.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "unplugin-fonts": "^1.4.0",
    "vite": "npm:rolldown-vite@^7.2.5",
    "vite-plugin-neutralino": "^1.0.3"
  }
}
